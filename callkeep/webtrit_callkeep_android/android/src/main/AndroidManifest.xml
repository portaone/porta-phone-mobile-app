<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.webtrit.callkeep">

    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Signature-level permission used to protect internal IC_RELEASE broadcasts.
        Only components signed with the same key can send or receive these broadcasts.
    -->
    <permission
        android:name="${applicationId}.INTERNAL_BROADCAST"
        android:protectionLevel="signature" />
    <!--
        The app must also hold the permission it declares so that intra-app
        sendBroadcast(intent, permission) passes the receiver permission check,
        and registerReceiver(broadcastPermission) passes the sender permission check.
    -->
    <uses-permission android:name="${applicationId}.INTERNAL_BROADCAST" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
        Declare android.software.telecom as optional so Play Store filters and device
        compatibility checks correctly reflect that the app works without the Telecom
        subsystem. Where this feature is absent - and on any release below API 26, where a
        self-managed PhoneAccount cannot be registered - StandaloneCallService is used
        instead of PhoneConnectionService for call management.
    -->
    <uses-feature
        android:name="android.software.telecom"
        android:required="false" />

    <application>
        <!--
          Telecom-backed connection service. Runs in the dedicated :callkeep_core process and is
          bound by the Telecom system server (BIND_TELECOM_CONNECTION_SERVICE). Incoming/outgoing
          calls are reported via TelecomManager.addNewIncomingCall / placeCall, so Telecom itself
          binds and launches this process (BIND_AUTO_CREATE) even when an app-side startService is
          blocked by the same OEM "process is bad" throttle described for StandaloneCallService
          below. App-side startService is used only for in-process IPC on an already-bound service
          (tear-down, sync, best-effort pending pre-registration), never to start the incoming-call
          flow.
        -->
        <service
            android:name=".services.services.connection.PhoneConnectionService"
            android:enabled="true"
            tools:targetApi="o"
            android:exported="false"
            android:label="PhoneConnectionService"
            android:process=":callkeep_core"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!--
          Standalone call management service for everything Telecom cannot host our calls on:
          no android.software.telecom feature, or a release below API 26 with no self-managed
          PhoneAccount.
          Runs in the main process (not :callkeep_core) because some OEM devices (e.g. Lenovo
          TB300FU, Android 13) block foreground service starts for secondary processes,
          permanently marking the process as "bad" and preventing all subsequent service starts.
          Since there is no Telecom framework managing the lifecycle of this service, running in
          the main process is safe and avoids OEM background-start restrictions.

          Foreground service type is two-phase at runtime:
          - ringing promotes with phoneCall only. Since Android 14 the microphone
            type is while-in-use restricted and cannot be started from a background app state
            (no exemption applies, incl. high-priority FCM), which crashed the service in a loop
            on every push-delivered incoming call. The phoneCall type is unrestricted; its only
            runtime prerequisites are the FOREGROUND_SERVICE_PHONE_CALL and MANAGE_OWN_CALLS
            permissions declared above. Contrary to an earlier assumption recorded here, it does
            NOT require the android.software.telecom feature or an active Telecom connection.
          - an outgoing call promotes with phoneCall|microphone at setup: the user places it
            from the app, which is visible then, and the type would be refused at the answer if
            the user left the app while the call rang.
          - once the call is answered/established the service re-promotes with
            phoneCall|microphone (the app has a visible activity at that point) so microphone
            access survives the app going to background mid-call.
        -->
        <service
            android:name=".services.services.connection.StandaloneCallService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <service
            android:name=".services.services.incoming_call.IncomingCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <service
            android:name=".services.services.active_call.ActiveCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <service android:name=".services.services.foreground.ForegroundService" />

        <!--
          Runs while the app shows the phone's screen to the other side of a call. Since
          Android 14 a screen capture needs a running foreground service of the mediaProjection
          type, which the system starts only after the person has granted the capture; the app
          starts this one between the consent and the capture. Main process: the capture runs
          there.
        -->
        <service
            android:name=".services.services.screen_share.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Invisible trampoline behind the Answer action of the incoming-call notification.
          Answering has to end with the call screen on top, and an app is not allowed to start
          an activity from a background service. An activity PendingIntent sent by the system
          carries that permission with the user's tap, so the tap answers the call and opens the
          screen in one step; the trampoline forwards the answer to IncomingCallService exactly
          as the old service PendingIntent did. showWhenLocked lets the tap work from a
          lock-screen notification; the empty taskAffinity keeps this ephemeral activity out of
          the host app's task.
        -->
        <activity
            android:name=".activities.AnswerCallTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Invisible trampoline behind the Answer action of the standalone incoming-call
          notification. Android 12+ forbids services launched from a notification action from
          starting activities (notification trampoline restriction), so the Answer PendingIntent
          targets this activity instead: it forwards the answer command to StandaloneCallService,
          brings the host app to the front and finishes. showWhenLocked lets the tap work from the
          lock-screen notification; the empty taskAffinity keeps this ephemeral activity out of
          the host app's task.
        -->
        <activity
            android:name=".activities.StandaloneAnswerTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Invisible trampoline behind the Answer action of a waiting call's notification (a call
          callkeep holds in its queue while another incoming call rings). Answering ends the
          ringing call, answers this one once it rings and has to open the call screen; the
          activity PendingIntent carries the launch permission with the user's tap.
        -->
        <activity
            android:name=".activities.QueuedCallTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The Decline current action of a waiting call's notification: ends the ringing call. -->
        <receiver
            android:name=".services.receivers.QueuedCallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
